  "scripts": {
    "start": "expo start",
    "dev:local": "EXPO_PUBLIC_API_BASE_URL=http://localhost:3000 EXPO_PUBLIC_API_BASE_URL_NATIVE= expo start",
    "dev:cloud": "EXPO_PUBLIC_API_BASE_URL=http://localhost:3000 EXPO_PUBLIC_API_BASE_URL_NATIVE=https://guitarcoach-685026468764.us-east1.run.app expo start",
    "dev:cloud-web": "node scripts/dev-cloud-web.mjs https://guitarcoach-685026468764.us-east1.run.app",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:coverage:open": "jest --coverage; c=$?; node -e \"const p=process.platform;require('child_process').spawn(p==='darwin'?'open':p==='win32'?'start':'xdg-open',['coverage/index.html'],{shell:p==='win32',detached:true,stdio:'ignore'}).unref()\"; exit $c",
    "format": "biome check --write . && prettier --write \"**/*.md\"",
    "format:check": "biome ci . && prettier --check \"**/*.md\"",
    "api:types": "openapi-typescript ${BACKEND_OPENAPI_PATH:-../guitar-coach/openapi.json} -o src/types/api.d.ts && biome check --write src/types/api.d.ts",
    "api:types:remote": "openapi-typescript $EXPO_PUBLIC_API_BASE_URL/docs-json -o src/types/api.d.ts && biome check --write src/types/api.d.ts",
    "api:types:check": "npm run api:types && git diff --exit-code src/types/api.d.ts && tsc --noEmit"
  },
  "private": true
