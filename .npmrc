# openapi-typescript@7.13.0 declares peerDependencies.typescript as "^5.x";
# this repo is already on TypeScript 6.0.3 and openapi-typescript has no
# published version with an updated peer range yet. It's a devDependency-only
# codegen tool (not shipped), and running it against this schema works fine
# in practice -- verified against the actual backend openapi.json. Revisit
# once openapi-typescript publishes a TS 6-compatible peer range.
legacy-peer-deps=true
