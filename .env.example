# The bare origin of the API — no trailing slash and no /api/v1. `src/api/client.ts` adds the
# /api/v1 prefix itself, and /auth/*, /health/* and /docs-json sit at the root.
# Used by the browser, and by native too unless the override below is set.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# iOS/Android only. Set this to run on a physical phone, where `localhost` resolves to the
# phone rather than your Mac — the browser keeps using the local backend above. Put it in
# `.env.local` rather than here; see README, "Running against the deployed backend".
# EXPO_PUBLIC_API_BASE_URL_NATIVE=https://guitarcoach-685026468764.us-east1.run.app
