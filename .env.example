# The bare origin of the API — no trailing slash and no /api/v1. `src/api/client.ts` adds the
# /api/v1 prefix itself, and /auth/*, /health/* and /docs-json sit at the root.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# The deployed Cloud Run backend, for running on a physical phone (where `localhost` resolves
# to the phone, not your Mac). Put it in `.env.local` rather than here — see README,
# "Running against the deployed backend".
# EXPO_PUBLIC_API_BASE_URL=https://guitarcoach-685026468764.us-east1.run.app
